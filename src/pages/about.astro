---
import "../assets/app.css";
import Footer from "../layouts/Footer.astro";
import Nav from "../layouts/Nav.astro";
import Header from "../layouts/Header.astro";
---

<html lang="en">
	<Header title="WildThorns Studio" />
	<body class="bg-[#060101] flex flex-col min-h-screen">
		<Nav />
		<main class="flex-grow justify-center mx-auto max-w-5xl px-4 text-white">
			<section class="py-4">
				<h1 class="pb-4 piedra-regular">Meet the team</h1>
				<div class="grid grid-cols-3 gap-4">
					<div>
						<img
							src="/site/Chibi_Dodo.png"
							alt="Laniesse Dorian"
							height="144"
							width="144"
							class="size-36 object-cover"
						/>
						<p class="font-bold">LANIESSE Dorian</p>
						<p class="text-[#d92820]">Director & Game Designer</p>
					</div>

					<div>
						<img
							src="/site/Chibi_Didieu.png"
							alt="Gollas Mathéo"
							height="144"
							width="144"
							class="size-36 object-cover"
						/>
						<p class="font-bold">GOLLAS Mathéo</p>
						<p class="text-[#d92820]">Producer & Audio Director</p>
					</div>
					<div>
						<img
							src="/site/Chibi_Mamar.png"
							alt="Bajeux Marius"
							height="144"
							width="144"
						/>
						<p class="font-bold">BAJEUX Marius</p>
						<p class="text-[#d92820]">Motion Designer & 2D Game Artist</p>
					</div>

					<div>
						<img
							src="/site/Chibi_Robby.png"
							alt="Schneider Robby"
							height="144"
							width="144"
							class="size-36 object-cover"
						/>
						<p class="font-bold">SCHNEIDER Robby</p>
						<p class="text-[#d92820]">3D Game Artist</p>
					</div>
					<div>
						<img
							src="/site/Chibi_Lili.png"
							alt="Lebrun Lili"
							height="144"
							width="144"
							class="size-36 object-cover"
						/>
						<p class="font-bold">LEBRUN Lili</p>
						<p class="text-[#d92820]">3D Game Artist</p>
					</div>
					<div>
						<img
							src="/site/Chibi_Talya.png"
							alt="Nazlim Talya"
							height="144"
							width="144"
							class="size-36 object-cover"
						/>
						<p class="font-bold">NAZLIM Talya</p>
						<p class="text-[#d92820]">Animator Artist</p>
					</div>

					<div>
						<img
							src="/site/Chibi_Mathox.png"
							alt="Lejeune Mathéo"
							height="144"
							width="144"
							class="size-36 object-cover"
						/>
						<p class="font-bold">LEJEUNE Mathéo</p>
						<p class="text-[#d92820]">Game Programmer</p>
					</div>
					<div>
						<img
							src="/site/Chibi_Antho.png"
							alt="Califice Antoine"
							height="144"
							width="144"
							class="size-36 object-cover"
						/>
						<p class="font-bold">CALIFICE Antoine</p>
						<p class="text-[#d92820]">Tech Artist</p>
					</div>
				</div>
			</section>
			<section>
				<h1 class="py-2 piedra-regular">Our values</h1>
				<p class="py-2">
					The Wild Thorns team is ready to stand up for its beliefs to
					the very end by producing works that are 100%
					socially conscious. We identify the issues within our
					society and savagely poke at the very places where it hurts.
				</p>
				<p class="pt-2 pb-8">
					We advocate for equality for all, freedom of expression, and
					the flourishing of society within a framework of sustainable
					and healthy development for generations to come.
				</p>
			</section>
		</main>
	</body>
	<Footer />
</html>
