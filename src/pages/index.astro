---
import Footer from "../layouts/Footer.astro";
import Nav from "../layouts/Nav.astro";
import Header from "../layouts/Header.astro";
import "../assets/app.css";
---

<html lang="en">
	<Header title="WildThorns Studio" />
	<body class="flex flex-col bg-[#060101] min-h-screen">
		<Nav />
		<main class="flex-grow justify-center mx-auto max-w-5xl px-4">
			
			<div class="flex flex-col items-center justify-center">
				<h1 class="py-4 piedra-regular">Welcome on the WildThorns Page</h1>
				<img
					src="/site/WildThorns.png"
					alt="Euphonia picture"
					class="size-96 justify-center"
				/>

				<p class="piedra-regular text-3xl pt-4">
					Gnashing fangs and grasping vines prowling at your mind.
				</p>

				<p class="piedra-regular text-3xl">
					We brings ecological topics to the gaming industry in an
					unapologetically punk ways.
				</p>

			</div>
		</main>
		<Footer />
	</body>
</html>
